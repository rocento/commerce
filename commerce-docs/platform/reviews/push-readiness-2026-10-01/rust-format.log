 #[cfg(test)]
 mod tests {
- use super::*;
- fn weight()->SellingRule {SellingRule{kind:Kind::Weight,measure_unit:MeasureUnit::Kg,measure_per_unit:Decimal::new(25,2),minimum:1,maximum:40,increment:1,estimated_weight:None,final_weight:None,regulated:false}}
- #[test] fn exact_money_has_no_implicit_fx(){for currency in ["USD","EGP"] {assert!(exact_money(Decimal::new(1001,2),currency).is_ok());assert!(exact_money(Decimal::new(1001,3),currency).is_err());} assert!(exact_money(Decimal::ONE,"EUR").is_err());}
- #[test] fn physical_measure_maps_to_exact_inventory_quanta(){let r=weight();assert_eq!(r.count_for(Decimal::new(75,2)).unwrap(),3);assert!(r.count_for(Decimal::new(76,2)).is_err());assert!(r.count_for(Decimal::ZERO).is_err());assert!(r.count_for(Decimal::from(11)).is_err());}
- #[test] fn pack_and_restricted_rules_fail_closed(){let mut r=weight();r.minimum=2;r.increment=2;assert!(r.quantity(3).is_err());assert!(r.quantity(4).is_ok());r.regulated=true;assert!(r.quantity(4).is_err());r.regulated=false;r.kind=Kind::VariableWeight;assert!(r.quantity(4).is_err());}
+    use super::*;
+    fn weight() -> SellingRule {
+        SellingRule {
+            kind: Kind::Weight,
+            measure_unit: MeasureUnit::Kg,
+            measure_per_unit: Decimal::new(25, 2),
+            minimum: 1,
+            maximum: 40,
+            increment: 1,
+            estimated_weight: None,
+            final_weight: None,
+            regulated: false,
+        }
+    }
+    #[test]
+    fn exact_money_has_no_implicit_fx() {
+        for currency in ["USD", "EGP"] {
+            assert!(exact_money(Decimal::new(1001, 2), currency).is_ok());
+            assert!(exact_money(Decimal::new(1001, 3), currency).is_err());
+        }
+        assert!(exact_money(Decimal::ONE, "EUR").is_err());
+    }
+    #[test]
+    fn physical_measure_maps_to_exact_inventory_quanta() {
+        let r = weight();
+        assert_eq!(r.count_for(Decimal::new(75, 2)).unwrap(), 3);
+        assert!(r.count_for(Decimal::new(76, 2)).is_err());
+        assert!(r.count_for(Decimal::ZERO).is_err());
+        assert!(r.count_for(Decimal::from(11)).is_err());
+    }
+    #[test]
+    fn pack_and_restricted_rules_fail_closed() {
+        let mut r = weight();
+        r.minimum = 2;
+        r.increment = 2;
+        assert!(r.quantity(3).is_err());
+        assert!(r.quantity(4).is_ok());
+        r.regulated = true;
+        assert!(r.quantity(4).is_err());
+        r.regulated = false;
+        r.kind = Kind::VariableWeight;
+        assert!(r.quantity(4).is_err());
+    }
 }
 

+            &f.admin,
+            "tracking",
+            "Invalid pickup dispatch"
+        )
+        .await
+        .is_err());
+    for status in ["pickup_ready", "picked_up", "cash_collected"] {
+        svc.transition(order.order.id, &f.admin, status, "Test pickup")
+            .await
+            .unwrap();
+    }
+    assert_eq!(count(&pool, "fulfillment.capacity_reservations").await, 0);
 }

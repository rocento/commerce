+    if request.uri().path().starts_with("/v1/") || request.uri().path().starts_with("/api/") {
+        return blocked(StatusCode::NOT_FOUND);
+    }
+    let Some(template) = &a.deployment.html else {
+        return blocked(StatusCode::SERVICE_UNAVAILABLE);
+    };
+    let Ok(Json(settings)) = public(State(a.clone())).await else {
+        return blocked(StatusCode::SERVICE_UNAVAILABLE);
+    };
+    let policy = a.deployment.resolve(&settings);
+    let directive = if crate::public_commerce::policy::public_page(request.uri().path())
+        && request.uri().query().is_none()
+    {
+        policy.robots_meta
+    } else {
+        "noindex, nofollow"
+    };
+    let html = template.replacen(
+        "</head>",
+        &format!("<meta name=\"robots\" content=\"{directive}\"/></head>"),
+        1,
+    );
+    (
+        [
+            ("content-type", "text/html; charset=utf-8"),
+            ("x-robots-tag", directive),
+        ],

{
  "name": "commerce-language-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node scripts/deploy-start.ts",
    "migrate": "node scripts/database.ts migrate",
    "activate-release": "node scripts/activate-release.ts",
    "export:release": "node scripts/export-release.ts",
    "export:db-release": "node scripts/export-db-release.ts",
    "generate": "node scripts/generate.ts",
    "compile": "node scripts/compile.ts",
    "verify:artifacts": "node scripts/verify-artifacts.ts",
    "evaluate": "node scripts/evaluate.ts",
    "evaluate:orders": "node scripts/evaluate-order-requests.ts --split all",
    "evaluate:understanding": "node scripts/evaluate-understanding.ts",
    "benchmark": "node scripts/benchmark.ts",
    "cli": "node scripts/cli.ts",
    "inspect:intent": "node scripts/inspect.ts intent",
    "inspect:group": "node scripts/inspect.ts group",
    "search:term": "node scripts/inspect.ts term",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/integration.ts",
    "evaluate:coverage": "node scripts/evaluate-coverage.ts",
    "evaluate:intent-discovery": "node scripts/evaluate-intent-discovery.ts",
    "calibrate-confidence": "node scripts/calibrate-confidence.ts",
    "demo:context": "node scripts/context-demo.ts",
    "test:semantic": "node --test tests/semantic-request.test.ts tests/semantic-http.test.ts",
    "evaluate:transfers": "node scripts/evaluate-transfers.ts",
    "prune:unsupported": "node scripts/prune-unsupported.ts",
    "evaluate:requests": "node scripts/evaluate-requests.ts",
    "enrich:vocabulary": "node scripts/enrich-vocabulary.ts",
    "import:knowledge": "node scripts/import-language-knowledge.ts",
    "quality": "node scripts/quality.ts",
    "release:stage": "node scripts/release.ts stage",
    "release:import": "node scripts/release.ts import",
    "release:evaluate": "node scripts/release.ts evaluate",
    "release:promote": "node scripts/release.ts promote",
    "release:bootstrap": "node scripts/release.ts bootstrap",
    "release:rollback": "node scripts/release.ts rollback",
    "release:inspect": "node scripts/release.ts inspect",
    "verify:runtime": "node scripts/deploy-start.ts --verify-only",
    "release:draft-new": "node scripts/release.ts draft-new",
    "release:draft-revise": "node scripts/release.ts draft-revise",
    "release:draft-freeze": "node scripts/release.ts draft-freeze",
    "release:import-baseline": "node scripts/release.ts import-baseline",
    "recognition:export": "node scripts/recognition.ts export",
    "recognition:stage": "node scripts/recognition.ts stage",
    "recognition:upgrade": "node scripts/recognition.ts upgrade"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}

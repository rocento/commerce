{
  "$defs": {
    "ActorContext": {
      "additionalProperties": false,
      "description": "Only the trusted gateway/composition root may construct this context.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "store_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Store Id",
          "type": "string"
        },
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "principal_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Principal Id"
        },
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "storefront",
            "admin",
            "evaluation"
          ],
          "title": "Channel",
          "type": "string"
        },
        "scopes": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "store_id",
        "session_id",
        "request_id",
        "channel"
      ],
      "title": "ActorContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/ActorContext"
    },
    "conversation_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "locale": {
      "default": "en",
      "maxLength": 35,
      "minLength": 2,
      "title": "Locale",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "deadline_at": {
      "anyOf": [
        {
          "maximum": 253402300799,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline At"
    }
  },
  "required": [
    "actor"
  ],
  "title": "TurnContext",
  "type": "object"
}

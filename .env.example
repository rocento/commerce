POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=local-commerce-only
CLICKHOUSE_USER=commerce
CLICKHOUSE_PASSWORD=local-analytics-only
MEILI_MASTER_KEY=local-search-key-change-me
MINIO_ROOT_USER=commerce
MINIO_ROOT_PASSWORD=local-storage-only
COMMERCE_LOG=info

# Generate a local key: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=local-development-replace-with-a-random-key-before-use

# M3 cart reservations (seconds); use 60 for an expiry demo.
RESERVATION_TTL_SECONDS=900

# Local support/assistant tenant used by support ticket routes.
ASSISTANT_TENANT_ID=91d13451-cb20-44a8-8522-e06534aeae17

# Optional storefront tile provider overrides. Empty uses OpenStreetMap with attribution.
# Recreate the storefront after changes; production Vite builds bake these into assets.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Optional M01 provider overlay; secrets stay in a server-side file, never VITE_*.
# Set AI_MODEL_NAME to a Responses-compatible model available in your OpenAI project.
AI_MODEL_NAME=
AI_MODEL_KEY_FILE=

# Assistant optimizations are opt-in; see commerce-docs/ai-service/configuration.md.
AI_FEATURE_FLAGS=
# Optional reviewed read recovery: also requires semantic_read_recovery and an approved example collection.
AI_SEMANTIC_RECOVERY_EMBEDDING_BUDGET=0
# Compound execution also requires commerce_planning,compound_execution in AI_FEATURE_FLAGS.
# Keep disabled until the isolated commerce pilot is accepted.
ASSISTANT_COMPOUND_WRITES_ENABLED=false
AI_SMALL_MODEL_NAME=
AI_MODEL_MAX_CALLS_PER_TURN=2
# USD microdollars per 1,000 tokens; zero means pricing is unconfigured.
AI_MODEL_INPUT_MICROS_PER_1K=0
AI_MODEL_OUTPUT_MICROS_PER_1K=0
AI_SMALL_MODEL_INPUT_MICROS_PER_1K=0
AI_SMALL_MODEL_OUTPUT_MICROS_PER_1K=0

# M04: optional approved knowledge retrieval. Model must support 1536 output dimensions.
AI_EMBEDDING_MODEL=
AI_KNOWLEDGE_COLLECTIONS=

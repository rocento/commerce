{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocento.com/contracts/mobile-experience/v1/build-manifest.schema.json",
  "title": "Rocento Native Build Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "merchantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "appDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^<>\\u0000-\\u001F]+$"
    },
    "iosBundleId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9-]*){2,8}$",
      "maxLength": 200
    },
    "androidApplicationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,8}$",
      "maxLength": 200
    },
    "iconAssetId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "splashAssetId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "associatedDomains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$",
        "maxLength": 253
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "environment": {
      "type": "string",
      "enum": [
        "staging",
        "production"
      ]
    },
    "storeAccountRef": {
      "type": "string",
      "pattern": "^store-account/[a-zA-Z0-9_-]{1,80}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    }
  },
  "required": [
    "merchantId",
    "appDisplayName",
    "iosBundleId",
    "androidApplicationId",
    "iconAssetId",
    "splashAssetId",
    "associatedDomains",
    "environment",
    "storeAccountRef",
    "sourceCommit",
    "runtimeVersion"
  ]
}

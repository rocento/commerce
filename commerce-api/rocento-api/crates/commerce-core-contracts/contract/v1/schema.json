{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rocento:commerce-core:1.0",
  "$defs": {
    "ActionEnvelope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ActorContext"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "expires_at": {
          "maximum": 253402300799,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        }
      },
      "required": [
        "context",
        "risk",
        "confirmation",
        "expires_at"
      ],
      "title": "ActionEnvelope",
      "type": "object"
    },
    "ActorContext": {
      "additionalProperties": false,
      "description": "Only the trusted gateway/composition root may construct this context.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "store_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Store Id",
          "type": "string"
        },
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "principal_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Principal Id"
        },
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "storefront",
            "admin",
            "evaluation"
          ],
          "title": "Channel",
          "type": "string"
        },
        "scopes": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "store_id",
        "session_id",
        "request_id",
        "channel"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "max_steps": {
          "default": 8,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_model_calls": {
          "default": 2,
          "maximum": 4,
          "minimum": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 6,
          "maximum": 16,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_tokens": {
          "default": 16384,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_cost_micros": {
          "default": 0,
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Max Cost Micros",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 25000,
          "maximum": 120000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CommerceSnapshot": {
      "additionalProperties": false,
      "description": "Reference to authoritative data; future milestones add domain-specific payloads.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "CommerceSnapshot",
      "type": "object"
    },
    "Confirmation": {
      "enum": [
        "none",
        "undo",
        "explicit_intent",
        "fresh_confirmation",
        "step_up"
      ],
      "title": "Confirmation",
      "type": "string"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "field": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "contains"
          ],
          "title": "Operator",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "strength": {
          "enum": [
            "hard",
            "soft",
            "inferred"
          ],
          "title": "Strength",
          "type": "string"
        },
        "source": {
          "enum": [
            "platform",
            "merchant",
            "customer",
            "catalog",
            "model"
          ],
          "title": "Source",
          "type": "string"
        },
        "scope": {
          "enum": [
            "goal",
            "product",
            "basket",
            "action"
          ],
          "title": "Scope",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field",
        "operator",
        "values",
        "strength",
        "source",
        "scope"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "ConstraintSet": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "constraints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "maxItems": 40,
          "title": "Constraints",
          "type": "array"
        },
        "conflict": {
          "default": "none",
          "enum": [
            "none",
            "clarify",
            "deny"
          ],
          "title": "Conflict",
          "type": "string"
        }
      },
      "title": "ConstraintSet",
      "type": "object"
    },
    "DecisionTrace": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "store_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Store Id",
          "type": "string"
        },
        "journey": {
          "enum": [
            "discovery",
            "shop",
            "optimize",
            "buy_again",
            "cart",
            "order",
            "general"
          ],
          "title": "Journey",
          "type": "string"
        },
        "path": {
          "enum": [
            "legacy",
            "core",
            "deterministic"
          ],
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "flag_off",
            "journey_disabled",
            "core_selected",
            "core_unavailable",
            "provider_unavailable",
            "existing_deterministic"
          ],
          "title": "Reason",
          "type": "string"
        },
        "versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DefinitionRef"
          },
          "maxItems": 40,
          "title": "Versions",
          "type": "array"
        },
        "deprecated": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DefinitionRef"
          },
          "maxItems": 40,
          "title": "Deprecated",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "store_id",
        "journey",
        "path",
        "reason"
      ],
      "title": "DecisionTrace",
      "type": "object"
    },
    "DefinitionRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        },
        "schema_major": {
          "const": 1,
          "default": 1,
          "title": "Schema Major",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "DefinitionRef",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "catalog",
            "commerce",
            "approved_knowledge",
            "customer",
            "inference"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
          "title": "Source Version",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "display": {
          "enum": [
            "cite",
            "saved_snapshot",
            "inference",
            "internal"
          ],
          "title": "Display",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "source_id",
        "source_version",
        "freshness",
        "display"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExecutionPlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "goal_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Goal Id",
          "type": "string"
        },
        "playbook": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/Budget",
          "default": {
            "schema_version": "1.0",
            "max_steps": 8,
            "max_model_calls": 2,
            "max_tool_calls": 6,
            "max_tokens": 16384,
            "max_cost_micros": 0,
            "timeout_ms": 25000
          }
        }
      },
      "required": [
        "goal_id",
        "playbook",
        "steps"
      ],
      "title": "ExecutionPlan",
      "type": "object"
    },
    "ExecutionState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
          "title": "Step Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus",
          "default": "pending"
        },
        "attempts": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "step_id"
      ],
      "title": "ExecutionState",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "FailureCategory": {
      "enum": [
        "retryable",
        "replannable",
        "user_action_required",
        "terminal"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observed_at": {
          "maximum": 253402300799,
          "minimum": 0,
          "title": "Observed At",
          "type": "integer"
        },
        "expires_at": {
          "maximum": 253402300799,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "revalidate_before_action": {
          "default": true,
          "title": "Revalidate Before Action",
          "type": "boolean"
        }
      },
      "required": [
        "observed_at",
        "expires_at"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "GoalState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ActorContext"
        },
        "status": {
          "$ref": "#/$defs/GoalStatus",
          "default": "created"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/Budget",
          "default": {
            "schema_version": "1.0",
            "max_steps": 8,
            "max_model_calls": 2,
            "max_tool_calls": 6,
            "max_tokens": 16384,
            "max_cost_micros": 0,
            "timeout_ms": 25000
          }
        },
        "executions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExecutionState"
          },
          "maxItems": 16,
          "title": "Executions",
          "type": "array"
        },
        "versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DefinitionRef"
          },
          "maxItems": 40,
          "title": "Versions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "context"
      ],
      "title": "GoalState",
      "type": "object"
    },
    "GoalStatus": {
      "enum": [
        "created",
        "planned",
        "running",
        "waiting_for_user",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "GoalStatus",
      "type": "string"
    },
    "IndustryPack": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility",
          "default": {
            "schema_version": "1.0",
            "tenants": [],
            "channels": [
              "storefront",
              "evaluation"
            ],
            "required_scopes": []
          }
        },
        "dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DefinitionRef"
          },
          "maxItems": 32,
          "title": "Dependencies",
          "type": "array"
        },
        "deprecated_after": {
          "anyOf": [
            {
              "maximum": 253402300799,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deprecated After"
        },
        "disabled_after": {
          "anyOf": [
            {
              "maximum": 253402300799,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled After"
        },
        "kind": {
          "const": "industry",
          "default": "industry",
          "title": "Kind",
          "type": "string"
        },
        "attributes": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Attributes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "IndustryPack",
      "type": "object"
    },
    "Intent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "goal": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "selected": {
          "$ref": "#/$defs/IntentCandidate"
        },
        "alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/IntentCandidate"
          },
          "maxItems": 5,
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "goal",
        "selected"
      ],
      "title": "Intent",
      "type": "object"
    },
    "IntentCandidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,119}$",
          "title": "Name",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "provenance": {
          "enum": [
            "explicit",
            "model",
            "rule"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 8,
          "title": "Evidence",
          "type": "array"

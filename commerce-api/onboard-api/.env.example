# Local development only; copy to .env. Never use production credentials.
APP_ENV=development
DATABASE_URL=postgres://rocento:local-only@127.0.0.1:5439/rocento
LOCAL_AUTH_ENABLED=false
# Set a random token (at least 32 characters) to enable the local customer fixture.
LOCAL_CUSTOMER_TOKEN=
PORT=4100
# Local customer account and email-link development settings.
# Generate AUTH_MAIL_KEY with: openssl rand -hex 32
AUTH_MAIL_KEY=
AUTH_MAIL_MODE=file
LOCAL_MAIL_DIR=.local/mail
CUSTOMER_ORIGIN=http://127.0.0.1:3100

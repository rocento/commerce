# Local development only; copy to .env. Never use production credentials.
APP_ENV=development
DATABASE_URL=postgres://rocento:local-only@127.0.0.1:5439/rocento
LOCAL_AUTH_ENABLED=false
# Set a random token (at least 32 characters) to enable the local customer fixture.
LOCAL_CUSTOMER_TOKEN=
PORT=4100
# Local customer account and email-link development settings.
# Generate AUTH_MAIL_KEY with: openssl rand -hex 32
AUTH_MAIL_KEY=
AUTH_MAIL_MODE=file
LOCAL_MAIL_DIR=.local/mail
CUSTOMER_ORIGIN=http://127.0.0.1:3100
# Rocento offline billing is disabled until instructions, plan terms and operator
# credentials are configured. Use approved amounts, not the proposed UI prices.
ROCENTO_PAYMENT_INSTRUCTIONS=
# JSON map: plan -> {amountMinor: integer, currency: string, serviceDays: integer}
ROCENTO_PAYMENT_TERMS={}
# Dedicated operator identity and random token (openssl rand -hex 32).
# Keep the token server/operator-side; never use a NEXT_PUBLIC_ variable.
ROCENTO_BILLING_OPERATOR_ID=
ROCENTO_BILLING_OPERATOR_TOKEN=

# Bounded concurrent checkpoints; each merchant host still serializes mutations.
PROVISIONING_CONCURRENCY=4

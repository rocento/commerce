{
  "name": "@rocento/react-native",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.28",
    "expo-crypto": "~57.0.4",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "android": "python3 scripts/build_android.py",
    "ios": "python3 scripts/build_ios.py",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog:sync": "node scripts/sync-catalogs.mjs",
    "catalog:check": "node scripts/sync-catalogs.mjs --check",
    "bundle": "expo export --platform ios --platform android",
    "bundle:web": "expo export --platform web --output-dir dist-web",
    "test:ui": "EXPO_PUBLIC_DEMO=1 npm run bundle:web && playwright test",
    "test:live-ui": "EXPO_PUBLIC_DEMO=0 expo export --platform web --output-dir dist-live && playwright test --config playwright.live.config.ts",
    "test:checkout-ui": "EXPO_PUBLIC_VISUAL_QA=1 EXPO_PUBLIC_ACCEPTANCE=0 EXPO_PUBLIC_DEMO=0 expo export --platform web --dev --output-dir dist-checkout && playwright test --config playwright.checkout.config.ts",
    "prebuild": "expo prebuild",
    "test:discovery-ui": "EXPO_PUBLIC_VISUAL_QA=1 EXPO_PUBLIC_ACCEPTANCE=0 EXPO_PUBLIC_DEMO=0 expo export --dev --platform web --output-dir dist-visual && playwright test --config playwright.discovery.config.ts",
    "postinstall": "node scripts/patch-dependencies.cjs",
    "test:dependencies": "node --test scripts/dependency-security.test.cjs scripts/audit-security.test.cjs",
    "audit:dependencies": "node scripts/audit-dependencies.cjs"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}

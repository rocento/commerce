+// hasUnsupportedUnsignedTrailer applies the upstream workaround for
+// CVE-2026-40344 and CVE-2026-41145 before authentication dispatch. Unsigned
+// trailer uploads are disabled; ordinary signed and signed-trailer uploads
+// remain supported. Check every value, including proxy-combined duplicates.
+func hasUnsupportedUnsignedTrailer(r *http.Request) bool {
+	for name, values := range r.Header {
+		if !strings.EqualFold(name, xhttp.AmzContentSha256) {
+			continue
+		}
+		for _, value := range values {
+			for _, token := range strings.Split(value, ",") {
+				if strings.EqualFold(strings.TrimSpace(token), unsignedPayloadTrailer) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}

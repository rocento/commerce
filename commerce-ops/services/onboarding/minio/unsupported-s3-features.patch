+// hasUnsupportedS3Feature disables S3 Select and replication metadata for this
+// single-store media service. These features are not part of its S3 contract.
+// Applying the upstream CVE-2026-39414 and CVE-2026-34204 workarounds here
+// protects direct S3 access as well as requests passing through a proxy.
+func hasUnsupportedS3Feature(r *http.Request) bool {
+	if r.URL.Query().Has("select") {
+		return true
+	}
+	for name := range r.Header {
+		if strings.HasPrefix(strings.ToLower(name), "x-minio-replication-") ||
+			strings.EqualFold(name, "X-Minio-Source-Replication-Request") {
+			return true
+		}
+	}
+	return false
+}

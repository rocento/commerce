    "commerce-ops/workflows/release/commerce_release.py",
    "commerce-ops/workflows/release/commerce_reliability.py",
    "commerce-ops/workflows/release/reliability_support.py",
    "commerce-ops/cloud/host/check.py",
    "commerce-ops/cloud/host/deployment_job.py"
  ],
  "legacy_inventory": "commerce-ops/config/entrypoints.json"

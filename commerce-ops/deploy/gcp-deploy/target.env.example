# Copy to target.env and fill locally. The file is ignored by Git.
GCLOUD_PROJECT=your-project-id
GCLOUD_ZONE=europe-west4-a
GCLOUD_INSTANCE=rocento-v1
# Optional: avoid the gcloud CLI lookup if the instance has a reserved address.
# GCLOUD_HOST=203.0.113.10
# Local private key path. Its matching PUBLIC key belongs in GCE SSH metadata.
GCLOUD_SSH_KEY=/Users/you/.ssh/rocento-gcp

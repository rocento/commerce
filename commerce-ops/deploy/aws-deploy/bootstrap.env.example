# Copy to commerce-ops/deploy/aws-deploy/bootstrap.env and set mode 600.
# The one-command launcher copies this protected file and the two Origin CA
# files to EC2. Values must be one KEY=value line each, without shell quotes.
DOMAIN=rocento.com
ORIGIN_CERT=/home/ubuntu/.rocento-secrets/rocento-origin.pem
ORIGIN_KEY=/home/ubuntu/.rocento-secrets/rocento-origin.key

# Required only when explicitly running deploy/ec2/server/ec2-seed-demo.sh on EC2.
# Normal deployment does not seed demo data or change demo administrators.
GROCERY_ADMIN_EMAIL=admin@demo.local
GROCERY_ADMIN_PASSWORD=
JEWELRY_ADMIN_EMAIL=admin@demo.local
JEWELRY_ADMIN_PASSWORD=

ELECTRONICS_ADMIN_EMAIL=electronics-admin@example.com
ELECTRONICS_ADMIN_PASSWORD=replace-with-a-unique-electronics-password

# Opt in to enforcing the configured account as the sole active demo admin.
# Applied only by ec2-seed-demo.sh to selected stores; revokes existing sessions.
DEMO_ADMIN_ENFORCE=0

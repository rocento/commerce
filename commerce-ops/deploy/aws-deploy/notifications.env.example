# Copy to notifications.env, fill the mailbox credential, chmod 600.
# Uploaded separately; enables SMTP for Grocery and Jewelry on the next deployment.
# Values are literal (no shell quotes or variable interpolation).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USERNAME=info@rocento.com
SMTP_PASSWORD=
NOTIFICATION_FROM=Rocento <info@rocento.com>

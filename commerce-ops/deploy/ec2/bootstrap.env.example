# Copy this file to deploy/ec2/bootstrap.env on the EC2 instance, fill the
# values, then run: chmod 600 deploy/ec2/bootstrap.env
# This file is intentionally ignored by Git. Values must be one physical line
# each; do not use shell syntax, command substitution, or quotes.
DOMAIN=rocento.com
ORIGIN_CERT=/home/ubuntu/.rocento-secrets/rocento-origin.pem
ORIGIN_KEY=/home/ubuntu/.rocento-secrets/rocento-origin.key

GROCERY_ADMIN_EMAIL=admin@example.com
GROCERY_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
JEWELRY_ADMIN_EMAIL=admin@example.com
JEWELRY_ADMIN_PASSWORD=replace-with-a-different-password-of-at-least-12-characters

ELECTRONICS_ADMIN_EMAIL=electronics-admin@example.com
ELECTRONICS_ADMIN_PASSWORD=replace-with-a-unique-electronics-password

# Opt in to enforcing the configured account as the sole active demo admin.
# Applied only by ec2-seed-demo.sh to selected stores; revokes existing sessions.
DEMO_ADMIN_ENFORCE=0

PHARMACY_ADMIN_EMAIL=pharmacy-admin@example.com
PHARMACY_ADMIN_PASSWORD=replace-with-a-unique-pharmacy-password

[Unit]
Description=Rocento company contact email
After=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=-/etc/rocento/contact.env
ExecStart=/usr/bin/python3 /opt/rocento-contact/server.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=96M

[Install]
WantedBy=multi-user.target

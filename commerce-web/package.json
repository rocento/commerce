{
  "name": "commerce-frontend",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test:admin": "playwright test",
    "test:grids": "playwright test --config playwright.grids.config.ts",
    "test:themes": "playwright test --config playwright.themes.config.ts",
    "test:theme-editor": "playwright test --config playwright.theme-editor.config.ts",
    "typecheck:admin-tests": "tsc -p e2e/tsconfig.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:admin:report": "playwright show-report",
    "dev:storefront": "pnpm --filter @commerce/storefront dev",
    "dev:admin": "pnpm --filter @commerce/admin dev",
    "dev:onboarding": "pnpm --filter @rocento/onboarding dev",
    "build:onboarding": "pnpm --filter @rocento/onboarding build",
    "typecheck:onboarding": "pnpm --filter @rocento/onboarding typecheck",
    "dev:onboarding-staff": "pnpm --filter @rocento/onboarding-staff dev",
    "build:onboarding-staff": "pnpm --filter @rocento/onboarding-staff build",
    "typecheck:onboarding-staff": "pnpm --filter @rocento/onboarding-staff typecheck",
    "test:onboarding": "playwright test --config playwright.onboarding.config.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../commerce-api/rocento-api/openapi.json -o packages/api-client/src/schema.d.ts",
    "test:improvements": "playwright test --config playwright.improvements.config.ts",
    "test:search": "playwright test --config playwright.search.config.ts",
    "dev:website": "pnpm --dir ../commerce-corporate-site dev",
    "build:website": "pnpm --dir ../commerce-corporate-site build",
    "test:admin:regression": "playwright test --config playwright.admin-regression.config.ts",
    "test:storefront:smoke": "playwright test --config playwright.storefront-smoke.config.ts",
    "test:navigation": "playwright test --config playwright.navigation.config.ts",
    "test:configuration": "playwright test --config playwright.configuration.config.ts",
    "dev:mobile-studio": "pnpm --filter @rocento/mobile-admin dev",
    "build:mobile-studio": "pnpm --filter @rocento/mobile-admin build",
    "test:mobile-studio": "playwright test --config playwright.mobile-studio.config.ts",
    "start:rengine": "pnpm --filter @rocento/rengine start",
    "test:rengine": "pnpm --filter @rocento/rengine test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  },
  "type": "module"
}

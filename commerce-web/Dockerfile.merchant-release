FROM node:22-bookworm-slim AS build
RUN npm install -g pnpm@10.32.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
RUN find . -type f -name '.env*' -delete
RUN pnpm install --frozen-lockfile
RUN VITE_SALES_CHANNEL=storefront pnpm --filter @commerce/storefront build && VITE_STOREFRONT_URL= pnpm --filter @commerce/admin build
FROM scratch
COPY --from=build /app/apps/storefront/dist /storefront
COPY --from=build /app/apps/admin/dist /admin

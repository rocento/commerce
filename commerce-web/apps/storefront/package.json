{
  "name": "@commerce/storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:publication": "vite build && vite build --ssr src/entry-public-server.tsx --outDir dist-server && node server/seal-build.mjs",
    "start:publication": "node server/start.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commerce/api-client": "workspace:*",
    "@commerce/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "leaflet": "1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21"
  }
}
